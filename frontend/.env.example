# Copy to .env.local and fill in. Never commit real values.

# Encrypts terms, notes, salts and agent keys at rest (32 random bytes, base64): openssl rand -base64 32
MASTER_KEY=
# Signs the daily settle cron (any long random string)
CRON_SECRET=

# bizzy-fy-attester.testnet: a full key (writes World ID facts) and a key limited to the escrow's settle methods
ATTESTER_KEY=
KEEPER_KEY=
# Pays 1 test NEAR once to each new testnet account, and the small fee for each Google (NEAR Auth) signature
SPONSOR_KEY=

# NEAR AI Cloud (private negotiation in a TEE); NEAR_AI_MODEL is optional
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# Google sign-in (NEAR Auth) shows on localhost; set to "on" elsewhere once NEAR Auth allows that address
NEXT_PUBLIC_NEAR_AUTH=

# World ID ("verified human")
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# production (the World App) or sandbox (the World sandbox testing app)
WORLD_ENVIRONMENT=production

# Optional: a hosted database (Turso). Without these, a local bizzy.db file is used.
DATABASE_URL=
DATABASE_TOKEN=

# Optional: your own domain, for share images
NEXT_PUBLIC_SITE_URL=
